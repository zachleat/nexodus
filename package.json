    "production": "npm run import && npm run build",
    "reset": "node reset.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "4.0.0-alpha.10",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-svelte": "^1.0.1",
    "@11ty/font-awesome": "^2.0.0",
    "@11ty/import": "^3.0.0-beta.7",
    "pagefind": "^1.5.2"
  }
}
