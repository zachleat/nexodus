---
pageTitle: Nexodus Archive
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title %}{{ title }} — {% endif %}{{ pageTitle }}</title>
		<style>{% include "styles.css" %}</style>
		<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
		<script src="/pagefind/pagefind-ui.js" defer></script>
		<script type="module">
		window.addEventListener("DOMContentLoaded", () => {
			new PagefindUI({ element: "#search", showSubResults: false, showImages: false, resetStyles: false, openFilters: ["source"], pageSize: 20 });
		});
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap">
				<a href="/" class="site-title">{{ pageTitle }}</a>
				<p class="site-tagline">Posts from Bluesky and the fediverse, kept in git.</p>
				<div id="search" role="search"></div>
			</div>
		</header>
		<main class="wrap">
			{{ content | safe }}
		</main>
		<footer class="site-footer wrap">
			<p>Built with <a href="https://www.11ty.dev/">11ty</a>, <a href="https://github.com/11ty/eleventy-import">11ty/import</a>, and <a href="https://pagefind.app/">Pagefind</a>. <a href="https://github.com/zachleat/nexodus">Source code</a></p>
		</footer>
	</body>
</html>
