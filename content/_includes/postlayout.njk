---
layout: layout.njk
---
{% set previousPost = collections.all | getPreviousCollectionItem %}
{% set nextPost = collections.all | getNextCollectionItem %}
{% set post = collections.all | getCollectionItem %}
{% set group = collections.postGroups | getPostGroup(page.url) %}
{%- for p in group.posts %}
<span hidden data-pagefind-filter="source">{{ p.data.sectionTitle }}</span>
{%- endfor %}
<span hidden data-pagefind-sort="date">{{ page.date.toISOString() }}</span>
<span hidden data-pagefind-meta="title">{{ page.date | readableDate }}</span>
{# Cross-posts are indexed once #}
{% set indexBody = group.primary.url == page.url %}
{% set postContent = content %}
{% include "post.njk" %}

<nav class="pager" aria-label="Posts">
	{% if nextPost %}<a href="{{ nextPost.url }}" rel="next">← Newer</a>{% else %}<span></span>{% endif %}
	{% if previousPost %}<a href="{{ previousPost.url }}" rel="prev">Older →</a>{% endif %}
</nav>
