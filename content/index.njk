---
layout: layout.njk
eleventyExcludeFromCollections: true
pagination:
  data: collections.postGroups
  size: 50
  alias: groups
permalink: "{% if pagination.pageNumber > 0 %}/page/{{ pagination.pageNumber + 1 }}/{% else %}/{% endif %}"
---
<p class="summary">{{ collections.all.length }} posts (<span class="post-source post-source--bluesky">{{ collections.bluesky.length }} Bluesky</span>, <span class="post-source post-source--fediverse">{{ collections.fediverse.length }} Fediverse</span>, {{ collections.all.length - collections.postGroups.length }} cross-posted) · page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</p>

<div class="feed">
{%- for group in groups %}
	{% set post = group.primary %}
	{% include "post.njk" %}
{%- endfor %}
</div>

<nav class="pager" aria-label="Pages">
	{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Newer</a>{% else %}<span></span>{% endif %}
	{% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older →</a>{% endif %}
</nav>
