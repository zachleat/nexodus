			},
			"date": "2024-07-05T15:11:05.193Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://fosstodon.org/@rauschma\" class=\"u-url mention\">@<span>rauschma</span></a></span> serifs are still dominating most long-form reading so surely there’s some truth to that</p>",
			"via": "fediverse"
		},
		{
			"id": "112734530854550036",
			"parentId": "112734514256637540",
			"url": "https://fediverse.zachleat.com/@zachleat/112734530854550036",
			"author": {
				"name": "Zach Leatherman",
				"url": "https://fediverse.zachleat.com/@zachleat",
				"avatarUrl": "https://cdn.masto.host/fediversezachleatcom/accounts/avatars/109/286/461/031/266/152/original/dc489c3746a44e00.png"
			},
			"date": "2024-07-05T15:13:46.372Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://mastodon.social/@kraftner\" class=\"u-url mention\">@<span>kraftner</span></a></span> ha—the browser would need to ship a different metric-compatible version sans-serif for *every* possible fallback 😅</p>",
			"via": "fediverse"
		},
		{
			"id": "112734534075981199",
			"parentId": "112734516625600748",
			"url": "https://fediverse.zachleat.com/@zachleat/112734534075981199",
