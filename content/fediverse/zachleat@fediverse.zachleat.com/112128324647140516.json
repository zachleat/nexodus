			"date": "2024-03-21T12:38:14.000Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://fosstodon.org/@bglw\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>bglw</span></a></span> <span class=\"h-card\" translate=\"no\"><a href=\"https://fediverse.zachleat.com/@zachleat\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>zachleat</span></a></span> hm, many options to choose from... I'll think about it...</p>",
			"via": "fediverse"
		},
		{
			"id": "112134516639206985",
			"parentId": "112133714442626070",
			"url": "https://fediverse.zachleat.com/@zachleat/112134516639206985",
			"author": {
				"name": "Zach Leatherman",
