		{
			"id": "111417127761285371",
			"parentId": "111417063337806664",
			"url": "https://mastodon.social/@sil/111417127471902562",
			"author": {
				"name": "Stuart Langridge",
				"url": "https://mastodon.social/@sil",
				"avatarUrl": "https://cdn.masto.host/fediversezachleatcom/cache/accounts/avatars/109/302/147/382/032/479/original/ab95a50a2e58e997.png"
			},
			"date": "2023-11-15T23:20:46.000Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://fediverse.zachleat.com/@zachleat\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>zachleat</span></a></span> voted for \"I would not currently do this\" :-) On the grounds that there's very little reason to do it; if you're switched-on enough to know about webp then you can write &lt;picture&gt; instead of &lt;img&gt;, and making multiple versions of your images is a one-time-only effort.</p>",
			"via": "fediverse"
		},
		{
			"id": "111417167636200411",
