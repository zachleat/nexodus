			},
			"date": "2025-01-27T14:12:31.832Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://front-end.social/@AmeliaBR\" class=\"u-url mention\">@<span>AmeliaBR</span></a></span> I only buy bananas from banana republic, if that helps</p>",
			"via": "fediverse"
		},
		{
			"id": "113900742411897945",
			"parentId": "113890351920412905",
			"url": "https://fediverse.zachleat.com/@zachleat/113900742411897945",
			"author": {
				"name": "Zach Leatherman",
