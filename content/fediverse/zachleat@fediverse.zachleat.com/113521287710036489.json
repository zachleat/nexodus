			},
			"date": "2024-11-21T15:47:09.000Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://fediverse.zachleat.com/@zachleat\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>zachleat</span></a></span> </p><p>#!/bin/bash<br>S=$(basename \"$0\");D=$((($(date +%s)-$(stat -c %Y \"$0\"))/86400))<br>[ $D -lt 1 ]&amp;&amp;echo \"Great job! You recently touched $S. Keep it up!\"&amp;&amp;exit 0<br>E=${<a href=\"https://toot.berlin/tags/D\" class=\"mention hashtag\" rel=\"nofollow noopener\" target=\"_blank\">#<span>D</span></a>};EXC=$(printf \"%${E}s\"|tr ' ' '!')<br>echo \"Please touch $S again$EXC\";exit $E</p>",
			"via": "fediverse"
		},
