			},
			"date": "2024-10-23T19:36:07.368Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://ruby.social/@konnorrogers\" class=\"u-url mention\">@<span>konnorrogers</span></a></span> <span class=\"h-card\" translate=\"no\"><a href=\"https://mastodon.social/@jakelazaroff\" class=\"u-url mention\">@<span>jakelazaroff</span></a></span> <a href=\"https://reactnative.dev/docs/stylesheet\" target=\"_blank\" rel=\"nofollow noopener\" translate=\"no\"><span class=\"invisible\">https://</span><span class=\"\">reactnative.dev/docs/stylesheet</span><span class=\"invisible\"></span></a> seems to match up</p>",
