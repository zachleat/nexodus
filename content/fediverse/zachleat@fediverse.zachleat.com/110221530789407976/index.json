		},
		{
			"id": "110222232653559038",
			"parentId": "110222168751765523",
			"url": "https://mastodon.social/@sil/110222232595637371",
			"author": {
				"name": "Stuart Langridge",
				"url": "https://mastodon.social/@sil",
				"avatarUrl": "https://cdn.masto.host/fediversezachleatcom/cache/accounts/avatars/109/302/147/382/032/479/original/ab95a50a2e58e997.png"
			},
			"date": "2023-04-18T22:43:17.000Z",
			"content": "<p><span class=\"h-card\"><a href=\"https://fediverse.zachleat.com/@zachleat\" class=\"u-url mention\" rel=\"nofollow noopener\" target=\"_blank\">@<span>zachleat</span></a></span> of course, and you’re fully doing the right thing, and no accusation. I don’t use jq these days because browsers do it all natively, which was the point of jq from the beginning. You know this, of course, and I know you know it! But those following: you should know this too.</p>",
			"via": "fediverse"
		},
		{
			"id": "110222553942374692",
			"parentId": "110221755201029443",
