				"name": "Zach Leatherman",
				"url": "https://fediverse.zachleat.com/@zachleat",
				"avatarUrl": "https://cdn.masto.host/fediversezachleatcom/accounts/avatars/109/286/461/031/266/152/original/dc489c3746a44e00.png"
			},
			"date": "2025-09-12T16:45:15.928Z",
			"content": "<p><span class=\"h-card\" translate=\"no\"><a href=\"https://fosstodon.org/@krinkle\" class=\"u-url mention\">@<span>krinkle</span></a></span> Huh… a choice they made or a browser quirk?</p>",
			"via": "fediverse"
		},
		{
			"id": "115192699922937015",
			"parentId": "115192333331884739",
			"url": "https://fosstodon.org/@krinkle/115192699876181548",
			"author": {
