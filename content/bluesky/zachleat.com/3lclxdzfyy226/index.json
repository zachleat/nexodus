				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:jxk45ekze4mv3v4vpipobzhu/bafkreia32atm7pe7zmqcucit7xfb2v2dytdyccr3il73pgk5lt3jz6q5im"
