			},
			"date": "2025-12-03T22:32:21.336Z",
			"content": "<p>for the record I’ve helped organize six different conferences and we’ve always paid speakers a stipend and paid for expenses</p>",
			"via": "bluesky"
		},
		{
			"id": "at://did:plc:ttgqy7ayajurv3rp3qtyjzy4/app.bsky.feed.post/3m74k4pm5rc27",
