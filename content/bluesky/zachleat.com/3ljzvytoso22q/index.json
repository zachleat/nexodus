				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:rzf7l6olyl67yfy2jwufdq7f/bafkreibbsrcnu4eml6civfhrgbmfanj3xy7gztrjsp2klrhdgfe3obp4he"
			},
			"date": "2025-03-10T22:28:16.804Z",
			"content": "<p>While working on the ESLint CSS plugin’s require-baseline rule, we discovered that cursor is not baseline due to incomplete mobile implementation. 🤷‍♂️</p>",
			"via": "bluesky"
		},
		{
			"id": "at://did:plc:2t2s7o2yd5pcaqp5fuflzdew/app.bsky.feed.post/3lk2nr2pjr22c",
			"parentId": "at://did:plc:xpchjovbk6sxl3bv74z7cs54/app.bsky.feed.post/3ljzvytozis2q",
			"url": "https://bsky.app/profile/joshtumath.uk/post/3lk2nr2pjr22c",
