				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:bsax2z6bbugsvljtmzwq4vrv/bafkreigem7asyqnu3sqr34eemimwnejbsmdxpcbw2jvzyrmaaalbzhdbc4"
