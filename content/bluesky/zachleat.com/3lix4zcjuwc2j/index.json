			"author": {
				"name": "Luke",
				"url": "https://bsky.app/profile/lukewarlow.dev",
				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:uthwv2jcpcccf4ec2bzsavg7/bafkreia3pmnk72btquz6ufuupstzrg7tb23smpinwmfntnk7lfl2gj7xae"
			},
			"date": "2025-02-25T11:56:07.190Z",
			"content": "<p>Why isn't it a .md file too...</p>",
