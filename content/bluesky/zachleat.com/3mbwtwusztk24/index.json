			},
			"date": "2026-01-08T23:21:17.866Z",
			"content": "<p>Tailwind laid off 75% of their staff claiming that people are using LLMs to do what the products they sell do</p>",
			"via": "bluesky"
		},
		{
			"id": "at://did:plc:j65yyxd3csvlqf7mhjm32mk2/app.bsky.feed.post/3mbxweld46s2v",
			"parentId": "at://did:plc:4v3uz6xgigawvz64fede7ly7/app.bsky.feed.post/3mbx3rqaprk2k",
			"url": "https://bsky.app/profile/naugtur.pl/post/3mbxweld46s2v",
			"author": {
