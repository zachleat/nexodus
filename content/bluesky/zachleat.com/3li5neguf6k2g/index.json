			},
			"date": "2025-02-19T00:04:17.674Z",
			"content": "<p>This only strengthens my impression that auto-registering is bad. 😅</p>",
			"via": "bluesky"
		},
		{
			"id": "at://did:plc:ec64xv7n5dszeizw56yr6b5h/app.bsky.feed.post/3liii3oxtus23",
			"parentId": "at://did:plc:4zaidtnw6g74outanobj5g2i/app.bsky.feed.post/3liihzu53tc2t",
