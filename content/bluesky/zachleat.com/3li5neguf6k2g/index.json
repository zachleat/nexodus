		{
			"id": "at://did:plc:xpchjovbk6sxl3bv74z7cs54/app.bsky.feed.post/3li5ocvdaqk2q",
			"parentId": 0,
			"url": "https://bsky.app/profile/zachleat.com/post/3li5ocvdaqk2q",
			"author": {
				"name": "Zach Leatherman",
				"url": "https://bsky.app/profile/zachleat.com",
				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:xpchjovbk6sxl3bv74z7cs54/bafkreie4yypxcxrte6shppdo6glzt7gtmueprazp3xndeksuw2uid2ecfm"
			},
			"date": "2025-02-14T16:57:26.241Z",
			"content": "<p><a href=\"https://bsky.app/profile/did:plc:vrrdgcidwpvn4omvn7uuufoo\">@jakelazaroff.com</a> has some lovely ideas documented here that overlap: <a href=\"https://til.jakelazaroff.com/html/define-a-custom-element/\">til.jakelazaroff.com/html/define-...</a></p>",
