				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:xpchjovbk6sxl3bv74z7cs54/bafkreie4yypxcxrte6shppdo6glzt7gtmueprazp3xndeksuw2uid2ecfm"
			},
			"date": "2025-02-18T23:08:29.603Z",
			"content": "<p>self-registering requires two request chain if you don’t want to duplicate code and you aren’t using a bundler, unless there is a technique I’m not aware of!</p>",
			"via": "bluesky"
		},
		{
			"id": "at://did:plc:4zaidtnw6g74outanobj5g2i/app.bsky.feed.post/3liifltzr3k2t",
			"parentId": "at://did:plc:ec64xv7n5dszeizw56yr6b5h/app.bsky.feed.post/3liiecqdims2h",
			"url": "https://bsky.app/profile/fvsch.com/post/3liifltzr3k2t",
			"author": {
