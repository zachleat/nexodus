				"avatarUrl": "https://cdn.bsky.app/img/avatar/plain/did:plc:f64vb5rx6mqokvtn3gbgtnkv/bafkreicwirkhki6y6iujb4eszhob5bfr3plqwlksspvfunewlv7p6djwwi"
			},
			"date": "2024-12-16T15:30:39.824Z",
			"content": "<p>Summarizing folks' well-informed sentiments about the measurably poor user experience of react sites as a whole as 'don't use JS' is a pretty lazy read. 🙄</p>",
			"via": "bluesky"
		},
		{
			"id": "at://did:plc:wjzw74n44kuehrcwoqerbuvn/app.bsky.feed.post/3ldgnnbntrc2o",
			"parentId": "at://did:plc:f64vb5rx6mqokvtn3gbgtnkv/app.bsky.feed.post/3ldgniigy622h",
			"url": "https://bsky.app/profile/heydonworks.com/post/3ldgnnbntrc2o",
			"author": {
				"name": "Large Heydon Collider",
